# Copy to .env.local and fill in. .env.local is gitignored.
# Supabase dashboard > Project Settings > API

# Public. Safe in the browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses Row Level Security, so it never reaches the browser.
# Used by the owner seed script and the account-deletion route handler.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The account that `npm run seed:owner` writes the private PPL plan to.
# Sign up in the app with this address first, then run the seed once.
SEED_OWNER_EMAIL=you@example.com
